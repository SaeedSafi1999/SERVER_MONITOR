@page "/settings"
@attribute [Authorize(Roles = Roles.Admin)]
@using ServerMonitor.Infrastructure.Alerting
@inject AlertManagementService Svc
@inject ToastService Toasts

<PageTitle>Settings · ServerMonitor</PageTitle>

<div class="page-header">
    <div>
        <h1>Settings</h1>
        <div class="sub">Collection, retention, SLA and notification channels</div>
    </div>
</div>

@if (_settings is null)
{
    <div class="skeleton" style="height:300px"></div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="glass form-section">
                <h2><i class="bi bi-activity me-2"></i>Collection</h2>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label small">ICMP packets per round</label><input type="number" class="form-control" min="1" max="20" @bind="_settings.IcmpPacketsPerRound" /></div>
                    <div class="col-md-6"><label class="form-label small">Probe timeout (ms)</label><input type="number" class="form-control" min="200" max="30000" @bind="_settings.ProbeTimeoutMs" /></div>
                    <div class="col-md-6"><label class="form-label small">Max concurrent collections</label><input type="number" class="form-control" min="1" max="256" @bind="_settings.MaxConcurrentCollections" /></div>
                    <div class="col-md-6"><label class="form-label small">Security scan interval (minutes)</label><input type="number" class="form-control" min="1" @bind="_settings.SecurityScanIntervalMinutes" /></div>
                    <div class="col-md-6"><label class="form-label small">SLA target (%)</label><input type="number" step="0.001" class="form-control" @bind="_settings.SlaTargetPercent" /></div>
                    <div class="col-md-6"><label class="form-label small">Certificate warning (days)</label><input type="number" class="form-control" @bind="_settings.CertificateWarningDays" /></div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="glass form-section">
                <h2><i class="bi bi-database me-2"></i>Data retention (days)</h2>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label small">Metrics</label><input type="number" class="form-control" @bind="_settings.MetricRetentionDays" /></div>
                    <div class="col-md-4"><label class="form-label small">Probes</label><input type="number" class="form-control" @bind="_settings.ProbeRetentionDays" /></div>
                    <div class="col-md-4"><label class="form-label small">Resolved alerts</label><input type="number" class="form-control" @bind="_settings.AlertRetentionDays" /></div>
                    <div class="col-md-4"><label class="form-label small">Security events</label><input type="number" class="form-control" @bind="_settings.SecurityEventRetentionDays" /></div>
                    <div class="col-md-4"><label class="form-label small">Audit log</label><input type="number" class="form-control" @bind="_settings.AuditRetentionDays" /></div>
                </div>
                <div class="small text-secondary mt-2">Old rows are purged hourly. Availability periods are kept for two years for SLA history.</div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end mb-4"><button class="btn btn-primary" @onclick="SaveSettingsAsync"><i class="bi bi-save me-1"></i>Save settings</button></div>

    <div class="page-header">
        <div><h1 class="h5">Notification channels</h1><div class="sub">Secrets (SMTP password, bot token, webhook secret) are stored encrypted and never displayed again.</div></div>
        <div class="actions">
            <button class="btn btn-sm btn-outline-light" @onclick="() => NewChannel(NotificationChannelType.Email)"><i class="bi bi-envelope me-1"></i>Email</button>
            <button class="btn btn-sm btn-outline-light" @onclick="() => NewChannel(NotificationChannelType.Telegram)"><i class="bi bi-telegram me-1"></i>Telegram</button>
            <button class="btn btn-sm btn-outline-light" @onclick="() => NewChannel(NotificationChannelType.Webhook)"><i class="bi bi-link-45deg me-1"></i>Webhook</button>
        </div>
    </div>

    @if (_channel is not null)
    {
        <div class="glass form-section">
            <h2>@(_channel.Id == 0 ? "New" : "Edit") @_channel.Type channel</h2>
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label small">Name</label><input class="form-control" @bind="_channel.Name" /></div>
                <div class="col-md-3">
                    <label class="form-label small">Minimum severity</label>
                    <select class="form-select" @bind="_channel.MinimumSeverity">@foreach (var s in Enum.GetValues<AlertSeverity>()) { <option value="@s">@s</option> }</select>
                </div>
                <div class="col-md-5 d-flex align-items-end gap-3">
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="chen" @bind="_channel.IsEnabled" /><label class="form-check-label small" for="chen">Enabled</label></div>
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="chres" @bind="_channel.NotifyOnResolve" /><label class="form-check-label small" for="chres">Notify on resolve</label></div>
                </div>
                @switch (_channel.Type)
                {
                    case NotificationChannelType.Email:
                        <div class="col-md-4"><label class="form-label small">SMTP host</label><input class="form-control" @bind="_email.SmtpHost" /></div>
                        <div class="col-md-2"><label class="form-label small">Port</label><input type="number" class="form-control" @bind="_email.SmtpPort" /></div>
                        <div class="col-md-2 d-flex align-items-end"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="ssl" @bind="_email.UseSsl" /><label class="form-check-label small" for="ssl">TLS</label></div></div>
                        <div class="col-md-4"><label class="form-label small">Username</label><input class="form-control" @bind="_email.Username" autocomplete="off" /></div>
                        <div class="col-md-4"><label class="form-label small">Password</label><input type="password" class="form-control" @bind="_email.Password" autocomplete="new-password" placeholder="@(_channel.Id == 0 ? "" : "•••• unchanged")" /></div>
                        <div class="col-md-4"><label class="form-label small">From</label><input class="form-control" @bind="_email.From" /></div>
                        <div class="col-md-4"><label class="form-label small">To (comma separated)</label><input class="form-control" @bind="_email.To" /></div>
                        break;
                    case NotificationChannelType.Telegram:
                        <div class="col-md-6"><label class="form-label small">Bot token</label><input type="password" class="form-control mono" @bind="_telegram.BotToken" autocomplete="off" /></div>
                        <div class="col-md-6"><label class="form-label small">Chat ID</label><input class="form-control mono" @bind="_telegram.ChatId" /></div>
                        break;
                    case NotificationChannelType.Webhook:
                        <div class="col-md-8"><label class="form-label small">URL</label><input class="form-control mono" @bind="_webhook.Url" placeholder="https://hooks.example.com/…" /></div>
                        <div class="col-md-4"><label class="form-label small">HMAC secret (optional)</label><input type="password" class="form-control" @bind="_webhook.Secret" autocomplete="off" /></div>
                        break;
                }
            </div>
            @if (_channel.Id != 0) { <div class="small text-warning mt-2">Stored secrets are never shown. Leave secret fields empty to keep the stored values.</div> }
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button class="btn btn-sm btn-outline-light" @onclick="() => _channel = null">Cancel</button>
                <button class="btn btn-sm btn-primary" @onclick="SaveChannelAsync">Save channel</button>
            </div>
        </div>
    }

    <div class="glass table-wrap">
        <table class="table-dark-glass">
            <thead><tr><th>Name</th><th>Type</th><th>Enabled</th><th>Min. severity</th><th>On resolve</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in _channels)
                {
                    <tr>
                        <td>@c.Name</td><td>@c.Type</td><td>@(c.IsEnabled ? "✓" : "—")</td><td>@c.MinimumSeverity</td><td>@(c.NotifyOnResolve ? "✓" : "—")</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-info" @onclick="() => TestAsync(c)">Send test</button>
                            <button class="icon-btn" @onclick="() => EditChannel(c)"><i class="bi bi-pencil"></i></button>
                            <button class="icon-btn" @onclick="() => DeleteChannelAsync(c)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_channels.Count == 0) { <div class="p-4 text-center text-secondary">No channels yet. Alerts are still visible in the notification center.</div> }
    </div>
}

@code {
    private SystemSettings? _settings;
    private List<NotificationChannel> _channels = [];
    private NotificationChannel? _channel;
    private EmailChannelConfig _email = new();
    private TelegramChannelConfig _telegram = new();
    private WebhookChannelConfig _webhook = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await Svc.GetSettingsAsync();
        _channels = await Svc.ChannelsAsync();
    }

    private async Task SaveSettingsAsync()
    {
        try { await Svc.SaveSettingsAsync(_settings!); Toasts.Success("Settings saved"); _settings = await Svc.GetSettingsAsync(); }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private void NewChannel(NotificationChannelType type)
    {
        _channel = new NotificationChannel { Name = $"{type} alerts", Type = type, EncryptedConfig = "" };
        _email = new(); _telegram = new(); _webhook = new();
    }

    private void EditChannel(NotificationChannel c)
    {
        _channel = new NotificationChannel { Id = c.Id, Name = c.Name, Type = c.Type, IsEnabled = c.IsEnabled, MinimumSeverity = c.MinimumSeverity, NotifyOnResolve = c.NotifyOnResolve, EncryptedConfig = "" };
        // Non-secret fields are pre-filled; secrets are blanked.
        switch (c.Type)
        {
            case NotificationChannelType.Email: _email = Svc.ReadChannelConfig<EmailChannelConfig>(c); _email.Password = null; break;
            case NotificationChannelType.Telegram: _telegram = Svc.ReadChannelConfig<TelegramChannelConfig>(c); _telegram.BotToken = ""; break;
            case NotificationChannelType.Webhook: _webhook = Svc.ReadChannelConfig<WebhookChannelConfig>(c); _webhook.Secret = null; break;
        }
    }

    private async Task SaveChannelAsync()
    {
        if (_channel is null) return;
        try
        {
            switch (_channel.Type)
            {
                case NotificationChannelType.Email: await Svc.SaveChannelAsync(_channel, _email); break;
                case NotificationChannelType.Telegram: await Svc.SaveChannelAsync(_channel, _telegram); break;
                default: await Svc.SaveChannelAsync(_channel, _webhook); break;
            }
            _channel = null;
            _channels = await Svc.ChannelsAsync();
            Toasts.Success("Channel saved");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private async Task DeleteChannelAsync(NotificationChannel c)
    {
        await Svc.DeleteChannelAsync(c.Id);
        _channels = await Svc.ChannelsAsync();
    }

    private async Task TestAsync(NotificationChannel c)
    {
        var msg = await Svc.TestChannelAsync(c.Id);
        if (msg.StartsWith("Failed")) Toasts.Error(msg); else Toasts.Success(msg);
    }
}
