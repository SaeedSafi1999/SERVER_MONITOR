# Copy to .env and change every value:  cp .env.example .env && chmod 600 .env
DB_PASSWORD=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
# Leave empty to have a random password written to the keys volume (initial-admin-password.txt).
ADMIN_PASSWORD=
TZ=UTC

# Where the app listens on the host. With the https profile (or nginx on this host) set HTTP_BIND=127.0.0.1.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# https profile: Caddy obtains a certificate automatically for a public DNS name pointing at this server.
SITE_ADDRESS=monitor.example.com

# Internal Docker network. Change both if 172.30.0.0/24 overlaps a network you monitor.
DOCKER_SUBNET=172.30.0.0/24
CADDY_IP=172.30.0.10
# IP of an external reverse proxy (e.g. nginx on the host: the Docker gateway, 172.30.0.1), so X-Forwarded-For is trusted from it.
PROXY_IP=

# Image name; set to a registry path if you build once and push (e.g. registry.example.com/servermonitor:1.0).
APP_IMAGE=servermonitor:latest

# Optional: protect the Data Protection key ring with a PFX certificate mounted into the container.
DP_CERT_PATH=
DP_CERT_PASSWORD=

# Only for the demo profile.
DEMO_SSH_PASSWORD=
